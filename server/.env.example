# ==========================================
# BRAVE GYM - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port (Railway sets this automatically, but required for local)
PORT=5000

# PostgreSQL Connection String
# On Railway: reference ${{Postgres.DATABASE_URL}}
# Or paste your Railway PostgreSQL URI here:
DATABASE_URL=postgresql://postgres:password@host:port/railway

# JWT Authentication
JWT_SECRET=brave_gym_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Uploads directory for avatars
UPLOAD_DIR=data/uploads
